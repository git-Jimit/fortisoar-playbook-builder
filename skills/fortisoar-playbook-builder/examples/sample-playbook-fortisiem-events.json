            {
              "@type": "WorkflowStep",
              "name": "setdate",
              "description": null,
              "arguments": {
                "config": "",
                "params": {
                  "python_function": "from datetime import datetime, timezone\n\nincident = {{vars.sourceData}}\n\ndef parse_incident_time(raw_time_str):\n    # Extract the first 13-digit epoch (milliseconds)\n    epoch_ms = int(str(raw_time_str)[:13])\n    # Convert to datetime in UTC\n    dt = datetime.fromtimestamp(epoch_ms / 1000, tz=timezone.utc)\n    # Format as ISO 8601 with milliseconds\n    return dt.strftime('%Y-%m-%dT%H:%M:%S.%f')[:-3] + 'Z'\n\n# Parse from_time and to_time from respective fields\nfrom_time = parse_incident_time(incident.get(\"incidentFirstSeen\", \"\"))\nto_time = parse_incident_time(incident.get(\"incidentLastSeen\", \"\"))\n\n# Prepare final payload\noutput = {\n    \"event_id\": incident.get(\"incidentId\"),\n    \"from_time\": from_time,\n    \"to_time\": to_time\n}\n\nprint(output)\n"
                },
                "version": "2.1.1",
                "connector": "code-snippet",
                "operation": "python_inline_code_editor",
                "operationTitle": "Execute Python Code",
                "step_variables": []
