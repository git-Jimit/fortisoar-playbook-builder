            {
              "@type": "WorkflowStep",
              "name": "Detect_Plan",
              "description": "Turns raw query rows into per-technique verdicts, a kill-chain view and a weighted score.",
              "arguments": {
                "config": "<SET_CONNECTOR_CONFIG_UUID>",
                "params": {
                  "python_function": "import json\ntrue, false, null = True, False, None\n\n# PHASE 1 - build the trigger plan.\n#\n# Deliberately narrow: this asks only \"is there a machine worth examining?\",\n# not \"does anything suspicious exist anywhere\". Each trigger names the field\n# carrying the entity and the field carrying an indicator, so later phases need\n# no per-trigger special cases.\n#\n# Triggers that send an IDENTICAL cond/groupby/AttrList/window are collapsed\n# into one query here and share a result - two DNS triggers differing only in\n# post-processing were otherwise scanning 47M rows twice.\n#\n# Full implementation trimmed for this example. Structure:\n#\n#   TRIGGERS = {\n#     \"T-DNS-RISKTLD\": {\n#        \"name\": ..., \"why\": ...,            # why-text is surfaced in the report\n#        \"cond\": '(eventType = \"...\")',\n#        \"groupby\": \"DNSInitiatorIP,DNSQNAME\",\n#        \"AttrList\": \"DNSInitiatorIP,DNSQNAME,COUNT(*)\",\n#        \"host_field\": \"DNSInitiatorIP\",     # what identifies the machine\n#        \"ioc_field\": \"DNSQNAME\",            # what can be blocked\n#        \"ioc_kind\": \"domain\",\n#        \"post\": \"tld\",                      # judged after the query, not in it\n#        \"hours\": 4, \"weight\": 5,\n#        \"corroborating_only\": False,        # True = adds weight, never starts a case\n#     }, ...\n#   }\n\n# ... implementation trimmed ...\n\nprint(json.dumps({\n    \"plan\": plan, \"plan_size\": len(plan),\n    \"queries\": queries, \"query_count\": len(queries),\n    \"queries_saved\": len(plan) - len(queries),\n    \"customer\": customer, \"from_time\": from_t, \"to_time\": to_t,\n    \"lookback_hours\": hours,\n}))\n"
                },
                "version": "2.1.4",
                "connector": "code-snippet",
                "operation": "python_inline_code_editor",
                "operationTitle": "Execute Python Code",
                "step_variables": {
                  "detect_meta": "{{ vars.steps.Detect_Plan.data['code_output'] }}"
                }
