            {
              "@type": "WorkflowStep",
              "name": "Build_Cases",
              "description": "Turns raw query rows into per-technique verdicts, a kill-chain view and a weighted score.",
              "arguments": {
                "config": "<SET_CONNECTOR_CONFIG_UUID>",
                "params": {
                  "python_function": "import json\ntrue, false, null = True, False, None\n\n# PHASE 3 - assemble a case file per machine.\n#\n# The pivot queries carry NO suspicion filter. Their results are assessed here,\n# in the context of a machine already under suspicion - which is what lets\n# ordinary activity read as notable. rundll32 is unremarkable estate-wide and\n# notable on a host that just resolved a generated domain.\n#\n# Rows are attributed back to a host by whichever address field the source\n# populates: reptDevIpAddr for process and file events, DNSInitiatorIP for DNS,\n# srcIpAddr for network controls. Matching hostName against an IP never works.\n#\n# File hashes seen on notable files are collected for reputation checking.\n\n# ... implementation trimmed ...\n\nprint(json.dumps({\n    \"cases\": cases, \"case_count\": len(cases),\n    \"triggered\": triggered, \"relay_trace\": relay_trace,\n    \"iocs\": all_iocs, \"has_iocs\": len(all_iocs) > 0,\n    \"pivot_missing\": pivot_missing, \"pivot_note\": pivot_note,\n    \"window\": window, \"customer\": customer,\n}))\n"
                },
                "version": "2.1.4",
                "connector": "code-snippet",
                "operation": "python_inline_code_editor",
                "operationTitle": "Execute Python Code",
                "step_variables": {
