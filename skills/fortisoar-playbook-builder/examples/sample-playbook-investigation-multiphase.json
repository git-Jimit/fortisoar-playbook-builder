            {
              "@type": "WorkflowStep",
              "name": "Find_Candidates",
              "description": "Turns raw query rows into per-technique verdicts, a kill-chain view and a weighted score.",
              "arguments": {
                "config": "<SET_CONNECTOR_CONFIG_UUID>",
                "params": {
                  "python_function": "import json\ntrue, false, null = True, False, None\n\n# PHASE 2 - fold trigger hits onto the MACHINE that produced them, and build\n# the deep-dive plan.\n#\n# Two things happen here that make the pattern work:\n#\n# 1. post-processing the SIEM cannot express - TLD suffix matching, label\n#    randomness, unknown-extension classification. CONTAIN is a substring test,\n#    so anything needing a suffix or numeric comparison belongs in Python.\n#\n# 2. ONE pivot query per area covering EVERY candidate, not one per host. Six\n#    areas across five hosts is 6 queries, not 30. The entity field is in the\n#    grouping, so rows are split by host afterwards.\n#\n# A relay pivot is also built: for each suspicious domain, ask the DNS logs\n# which machines actually queried it. Network controls report the device that\n# forwarded the query, which on a DNS server is every client behind it.\n\n# ... implementation trimmed ...\n\nprint(json.dumps({\n    \"triggered\": triggered,          # per-trigger result, for the report\n    \"candidates\": cand_list,\n    \"investigate\": investigate,      # top N by score\n    \"pivot_a\": pivot_a, \"pivot_b\": pivot_b,   # sharded across two steps\n    \"has_candidates\": len(investigate) > 0,\n    \"window\": window, \"customer\": customer,\n}))\n"
                },
                "version": "2.1.4",
                "connector": "code-snippet",
                "operation": "python_inline_code_editor",
                "operationTitle": "Execute Python Code",
                "step_variables": {
