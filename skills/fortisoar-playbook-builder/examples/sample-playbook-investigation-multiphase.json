            {
              "@type": "WorkflowStep",
              "name": "Assess",
              "description": "Turns raw query rows into per-technique verdicts, a kill-chain view and a weighted score.",
              "arguments": {
                "config": "<SET_CONNECTOR_CONFIG_UUID>",
                "params": {
                  "python_function": "import json\ntrue, false, null = True, False, None\n\n# PHASE 4 - reputation verdict, case verdict, and the block list.\n#\n# Reputation returns a rating, a not-found message, or nothing at all. All\n# three are distinct: nothing at all means the lookup FAILED and must not read\n# as a clean result.\n#\n# The verdict comes from the strongest single machine, never an estate total.\n# A machine surfaced only by the relay trace can outrank every candidate - it\n# queried the domains most and no trigger reached it, which is exactly the case\n# a sweep misses.\n#\n# Only externally-rated indicators reach the block list. Behavioural findings\n# go to a review list for an analyst to confirm.\n\n# ... implementation trimmed ...\n\nprint(json.dumps({\n    \"verdict\": verdict, \"severity\": severity, \"verdict_reason\": reason,\n    \"cases\": cases, \"enrichment\": enriched,\n    \"ioc_malicious\": n_mal, \"ioc_suspicious\": n_susp, \"ioc_no_response\": n_none,\n    \"enrichment_ok\": (n_none == 0),\n    \"block_domains\": block_domains,       # consumed by a blocking playbook\n    \"block_ips\": block_ips,\n    \"block_hashes\": block_hashes,\n    \"block_ready\": (len(block_domains) + len(block_ips) + len(block_hashes)) > 0,\n    \"review_indicators\": review,          # NOT auto-blocked\n    \"lead_host\": lead_host,\n    \"uninvestigated_askers\": uninvestigated,\n}))\n"
                },
                "version": "2.1.4",
                "connector": "code-snippet",
                "operation": "python_inline_code_editor",
                "operationTitle": "Execute Python Code",
                "step_variables": {
                  "assessed": "{{ vars.steps.Assess.data['code_output'] }}"
                }
              },
              "status": null,
              "top": "200",
              "left": "3600",
              "stepType": "/api/3/workflow_step_types/1fdd14cc-d6b4-4335-a3af-ab49c8ed2fd8",
              "group": null,
              "uuid": "3a1b383c-41f8-4896-8c03-69aabe0a13d4"
            },
            {
              "@type": "WorkflowStep",
              "name": "Build_Report",
              "description": "Turns raw query rows into per-technique verdicts, a kill-chain view and a weighted score.",
              "arguments": {
                "config": "<SET_CONNECTOR_CONFIG_UUID>",
                "params": {
                  "python_function": "import json\ntrue, false, null = True, False, None\n\n# PHASE 5 - the analyst-facing report.\n#\n# Order matters. Verdict and reasoning first, then a plain-language statement\n# of what was found - or an explicit statement that nothing was. Then a case\n# file per machine, then indicators, then the block list.\n#\n# Every finding carries three lines: how to verify it, what would make it\n# legitimate, and what would confirm it. The middle one is what lets an analyst\n# close something.\n#\n# Attribute names are translated for display (procName -> Process, DNSQNAME ->\n# Domain queried). The query that produced each finding is included small and\n# last, so it can be reproduced without competing with the finding itself.\n\n# ... implementation trimmed ...\n\nprint(json.dumps({\n    \"report_html\": html,\n    \"verdict\": verdict, \"severity\": severity,\n    \"block_domains\": block_domains, \"block_ips\": block_ips,\n    \"block_hashes\": block_hashes, \"block_ready\": block_ready,\n    \"pdf_file_name\": pdf_name,\n}))\n"
                },
                "version": "2.1.4",
                "connector": "code-snippet",
                "operation": "python_inline_code_editor",
                "operationTitle": "Execute Python Code",
                "step_variables": {
                  "report": "{{ vars.steps.Build_Report.data['code_output'] }}"
                }
              },
              "status": null,
              "top": "200",
              "left": "4000",
